---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Hero from '@/components/Hero.astro';
import Services from '@/components/Services.astro';
import Projects from '@/components/Projects.astro';
import Process from '@/components/Process.astro';
import Skills from '@/components/Skills.astro';
import About from '@/components/About.astro';
import Contact from '@/components/Contact.astro';
import { getCollection } from 'astro:content';

const lang = 'es';

// Load Collections
const allSite = await getCollection('site');
const hero = allSite.find((e) => e.data.lang === lang && e.id.includes('hero'));
const about = allSite.find((e) => e.data.lang === lang && e.id.includes('about'));
const contact = allSite.find((e) => e.data.lang === lang && e.id.includes('contact'));

const process = (await getCollection('process')).find((e) => e.data.lang === lang);

const allSkills = await getCollection('skills');
const skills = allSkills.find((e) => e.data.lang === lang);

const services = (
  await getCollection('services', ({ data }) => data.lang === lang)
).sort((a, b) => a.data.order - b.data.order);

const projects = (
  await getCollection('projects', ({ data }) => data.lang === lang)
).sort((a, b) => a.data.order - b.data.order);
---

<BaseLayout
  lang={lang}
  title="Leandro Fusco | Servicios Profesionales & Portafolio"
  description="Servicios de ingeniería de software, arquitectura backend en Go y soluciones DevOps / Docker en producción. Confiabilidad, automatización y alto rendimiento."
>
  {hero && <Hero hero={hero} lang={lang} />}
  <Services services={services} lang={lang} />
  {process && <Process process={process} lang={lang} />}
  <Projects projects={projects} lang={lang} />
  {skills && <Skills skills={skills} lang={lang} />}
  {about && <About about={about} lang={lang} />}
  {contact && <Contact contact={contact} lang={lang} />}
</BaseLayout>
