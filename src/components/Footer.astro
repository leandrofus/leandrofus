---
import type { Lang } from '@/utils/i18n';
import { useTranslations } from '@/utils/i18n';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const currentYear = new Date().getFullYear();
---

<footer class="border-t-2 border-grid mt-10 py-8 text-sm text-dim">
  <div class="max-w-6xl mx-auto px-5 sm:px-8 flex flex-col md:flex-row items-center justify-between gap-4">
    <p>© {currentYear} <span class="text-text font-semibold">Leandro Fusco</span>. {t('footer.rights')}</p>
    <div class="flex gap-6 font-mono text-xs">
      <a href="https://github.com/leandrofus" target="_blank" rel="noopener noreferrer" class="hover:text-cyan">github.com/leandrofus</a>
      <a href="mailto:leandrofusdev@gmail.com" class="hover:text-cyan">leandrofusdev@gmail.com</a>
    </div>
  </div>
</footer>
