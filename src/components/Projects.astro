---
import type { Lang } from '@/utils/i18n';
import { useTranslations } from '@/utils/i18n';
import type { CollectionEntry } from 'astro:content';
import { render } from 'astro:content';

interface Props {
  projects: CollectionEntry<'projects'>[];
  lang: Lang;
}

const { projects, lang } = Astro.props;
const t = useTranslations(lang);
const sectionId = lang === 'es' ? 'proyectos' : 'projects';

const withBody = await Promise.all(
  projects.map(async (project) => ({ project, Content: (await render(project)).Content }))
);
const clientWork = withBody
  .filter((p) => p.project.data.client)
  .sort((a, b) => (b.project.data.year ?? 0) - (a.project.data.year ?? 0));
const own = withBody.filter((p) => !p.project.data.client);
---

<section id={sectionId} class="section">
  <h2 class="section-title"><span class="text-cyan">//</span> {t('projects.title')}</h2>
  <p class="section-lead">{t('projects.subtitle')}</p>

  <h3 class="mt-10 font-mono text-sm text-sun">{t('projects.clients')}</h3>
  <div class="mt-4 space-y-6">
    {clientWork.map(({ project, Content }) => (
      <article class="chamfer card border-pink p-6 sm:p-8 grid grid-cols-1 md:grid-cols-12 gap-6" style="box-shadow: 6px 6px 0 #FF2E97">
        <div class="md:col-span-3">
          <p class="text-5xl font-bold text-sun">{project.data.year}</p>
          <p class="mt-1 font-mono text-xs text-pink">{t('projects.hired')}</p>
          <p class="mt-4 font-mono text-xs text-dim">{project.data.category}</p>
        </div>
        <div class="md:col-span-9">
          <h4 class="text-2xl sm:text-3xl font-bold">{project.data.title}</h4>
          <p class="mt-2 text-text leading-relaxed">{project.data.description}</p>
          <div class="md mt-3 text-sm"><Content /></div>
          <div class="mt-4 flex flex-wrap gap-1.5">
            {project.data.tags.map((tag) => <span class="tag">{tag}</span>)}
          </div>
          {(project.data.github || project.data.demo) && (
            <div class="mt-5 flex items-center gap-5 text-sm font-bold uppercase tracking-wider">
              {project.data.github && <a href={project.data.github} target="_blank" rel="noopener noreferrer" class="text-cyan hover:text-pink">{t('projects.view_code')} &gt;</a>}
              {project.data.demo && <a href={project.data.demo} target="_blank" rel="noopener noreferrer" class="text-sun hover:text-pink">{t('projects.view_demo')} &gt;</a>}
            </div>
          )}
        </div>
      </article>
    ))}
  </div>

  <h3 class="mt-16 font-mono text-sm text-sun">{t('projects.own')}</h3>
  <div class="mt-4 grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
    {own.map(({ project, Content }) => (
      <article class="card p-6 flex flex-col hover:border-cyan transition-colors">
        <p class="font-mono text-xs text-pink">{project.data.category}</p>
        <h4 class="mt-2 text-2xl font-bold">{project.data.title}</h4>
        <p class="mt-2 text-text text-sm leading-relaxed">{project.data.description}</p>
        <div class="md mt-3 text-sm"><Content /></div>
        <div class="mt-4 flex flex-wrap gap-1.5">
          {project.data.tags.map((tag) => <span class="tag">{tag}</span>)}
        </div>
        <div class="mt-auto pt-6 flex items-center gap-5 text-sm font-bold uppercase tracking-wider">
          {project.data.github ? (
            <a href={project.data.github} target="_blank" rel="noopener noreferrer" class="text-cyan hover:text-pink">{t('projects.view_code')} &gt;</a>
          ) : (
            <span class="text-dim font-mono text-xs normal-case">Proprietary</span>
          )}
          {project.data.demo && <a href={project.data.demo} target="_blank" rel="noopener noreferrer" class="text-sun hover:text-pink">{t('projects.view_demo')} &gt;</a>}
        </div>
      </article>
    ))}
  </div>
</section>
